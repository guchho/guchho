{
  "name": "@guchho/wasm",
  "version": "1.0.7",
  "description": "Guchho bundler compiled to WebAssembly (Node + browser)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guchho/guchho.git"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "exports": {
    ".": {
      "browser": "./index.mjs",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./bin/guchho.js": "./bin/guchho.js",
    "./lib/guchho.wasm": "./lib/guchho.wasm",
    "./package.json": "./package.json"
  },
  "bin": {
    "guchho-wasm": "./bin/guchho.js"
  },
  "files": [
    "index.mjs",
    "index.cjs",
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "bundler",
    "webassembly",
    "wasm",
    "javascript",
    "css",
    "html",
    "guchho"
  ],
  "license": "MIT"
}
