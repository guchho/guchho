{
  "name": "guchho",
  "version": "1.0.1",
  "description": "Fast build system for web applications",
  "bin": {
    "guchho": "bin/guchho.js"
  },
  "main": "lib/main.js",
  "scripts": {
    "postinstall": "node install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "install.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "bundler",
    "build",
    "javascript",
    "typescript",
    "css",
    "html",
    "minifier",
    "bundler",
    "guchho"
  ],
  "author": "Hemanta Gayen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guchho/guchho.git"
  },
  "bugs": {
    "url": "https://github.com/guchho/guchho/issues"
  },
  "homepage": "https://github.com/guchho/guchho#readme",
  "optionalDependencies": {
    "@guchho/aix-ppc64": "1.0.1",
    "@guchho/android-arm": "1.0.1",
    "@guchho/android-arm64": "1.0.1",
    "@guchho/android-x64": "1.0.1",
    "@guchho/darwin-arm64": "1.0.1",
    "@guchho/darwin-x64": "1.0.1",
    "@guchho/freebsd-arm64": "1.0.1",
    "@guchho/freebsd-x64": "1.0.1",
    "@guchho/linux-arm": "1.0.1",
    "@guchho/linux-arm64": "1.0.1",
    "@guchho/linux-ia32": "1.0.1",
    "@guchho/linux-loong64": "1.0.1",
    "@guchho/linux-mips64el": "1.0.1",
    "@guchho/linux-ppc64": "1.0.1",
    "@guchho/linux-riscv64": "1.0.1",
    "@guchho/linux-s390x": "1.0.1",
    "@guchho/linux-x64": "1.0.1",
    "@guchho/netbsd-arm64": "1.0.1",
    "@guchho/netbsd-x64": "1.0.1",
    "@guchho/openbsd-arm64": "1.0.1",
    "@guchho/openbsd-x64": "1.0.1",
