#include <windows.h>

1 ICON "@PROJECT_SOURCE_DIR@/src/api/favicon.ico"


VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0

BEGIN

    BLOCK "StringFileInfo"
    BEGIN

        BLOCK "040904E4"
        BEGIN

            VALUE "CompanyName", "CodeHemu"
            VALUE "FileDescription", "Fast build system for web applications"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "guchho"
            VALUE "LegalCopyright", "Copyright (C) CodeHemu"
            VALUE "OriginalFilename", "guchho.exe"
            VALUE "ProductName", "Guchho"
            VALUE "ProductVersion", "@PROJECT_VERSION@"

        END

    END


    BLOCK "VarFileInfo"
    BEGIN

        VALUE "Translation", 0x0409, 1200

    END

END