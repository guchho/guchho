{
  "name": "guchho",
  "version": "1.0.9",
  "description": "Fast build system for web applications",
  "bin": {
    "guchho": "bin/guchho.js"
  },
  "main": "lib/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": {
        "types": "./browser.d.ts",
        "import": "./lib/browser/index.mjs",
        "require": "./lib/browser/index.js"
      },
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "postinstall": "node install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "lib/",
    "index.d.ts",
    "browser.d.ts",
    "install.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "bundler",
    "build",
    "javascript",
    "typescript",
    "css",
    "html",
    "minifier",
    "guchho"
  ],
  "author": "Hemanta Gayen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guchho/guchho.git"
  },
  "bugs": {
    "url": "https://github.com/guchho/guchho/issues"
  },
  "homepage": "https://guchho.js.org",
  "peerDependencies": {
    "@guchho/wasm": "1.0.9"
  },
  "peerDependenciesMeta": {
    "@guchho/wasm": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@guchho/aix-ppc64": "1.0.9",
    "@guchho/android-arm": "1.0.9",
    "@guchho/android-arm64": "1.0.9",
    "@guchho/android-x64": "1.0.9",
    "@guchho/darwin-arm64": "1.0.9",
    "@guchho/darwin-x64": "1.0.9",
    "@guchho/freebsd-arm64": "1.0.9",
    "@guchho/freebsd-x64": "1.0.9",
    "@guchho/linux-arm": "1.0.9",
    "@guchho/linux-arm64": "1.0.9",
    "@guchho/linux-ia32": "1.0.9",
    "@guchho/linux-loong64": "1.0.9",
    "@guchho/linux-mips64el": "1.0.9",
    "@guchho/linux-ppc64": "1.0.9",
    "@guchho/linux-riscv64": "1.0.9",
    "@guchho/linux-s390x": "1.0.9",
    "@guchho/linux-x64": "1.0.9",
    "@guchho/netbsd-arm64": "1.0.9",
    "@guchho/netbsd-x64": "1.0.9",
    "@guchho/openbsd-arm64": "1.0.9",
    "@guchho/openbsd-x64": "1.0.9",
    "@guchho/openharmony-arm64": "1.0.9",
    "@guchho/sunos-x64": "1.0.9",
    "@guchho/win32-arm64": "1.0.9",
    "@guchho/win32-ia32": "1.0.9",
    "@guchho/win32-x64": "1.0.9"
  }
}
